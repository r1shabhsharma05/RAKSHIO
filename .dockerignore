# Keep the Docker build context small and the build reproducible:
# node_modules are installed fresh by `npm ci` in stage 1, and dist is
# rebuilt there too — never copy the host's copies into the image.
node_modules
dist
.git
# Local-only data, never pushed: 152 MB of raw training downloads and
# 31 MB of local test screenshots must not enter a build context.
ml/data/raw
tests/shots-local
